#!/usr/bin/env bash
# Application CI builds artifacts and proposes a draft infra PR; it never deploys.
set -euo pipefail
commit=$1
image=$2
[[ "$commit" =~ ^[a-f0-9]{40}$ ]]
[[ "$image" =~ ^ghcr.io/collisionlab/osrs-coord-preview@sha256:[a-f0-9]{64}$ ]]
artifact=$(realpath worker-dist/worker.js)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# gh's credential helper avoids putting credentials in URLs or logs.
gh auth setup-git
git clone -q --depth 1 https://github.com/collisionlab/infra.git "$work"
cd "$work"
branch="pin/osrs-coord-preview-${commit:0:12}"
git switch -q -c "$branch"
cp "$artifact" releases/coordinate-preview-worker.js
jq --arg commit "$commit" --arg image "$image" --arg sha "$(sha256sum "$artifact" | cut -d' ' -f1)" \
  '.commit=$commit | .image=$image | .workerSha256=$sha' releases/osrs-coord-preview.json > release.tmp
mv release.tmp releases/osrs-coord-preview.json
git add releases
git -c user.name=collisionlab-bot -c user.email=collisionlab-bot@users.noreply.github.com \
  commit -qm "Pin coordinate preview ${commit:0:12}"
git push -q origin "$branch"
cat > "$work/body.md" <<EOF
Pins the renderer image and matching Worker from collisionlab/osrs-coord-preview@$commit.

Image: \`$image\`

Review activation flags and the migration checklist before merging. This PR does not change them.
EOF
gh pr create --draft --repo collisionlab/infra --head "$branch" \
  --title "Pin coordinate preview ${commit:0:12}" --body-file "$work/body.md"
